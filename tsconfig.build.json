{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist/esm",
		"module": "ESNext",
		"target": "ES2018",
		"lib": ["dom", "esnext"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": [],
		"skipLibCheck": true,
		"strict": true,
		"noEmitOnError": true
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/__tests__/**",
		"src/**/*.test.*"
	]
}
